# Build output of the widget
widget/build/
*.app/

# Python
__pycache__/
*.pyc
.venv/

# Never publish personal data: indexes, transcripts, reports, exports, backups
*.jsonl
*.csv
index.json
categories.json
predictor.json
config.json
live/
*.task-eta-backup-*
benchmark/
report/
backup/

# macOS
.DS_Store

# Claude Code's own per-project files (approved commands can hold local paths)
.claude/
CLAUDE.local.md

# Exports and widget debug output (they can hold prompts and session names)
*.json
state.txt
click.txt
panel.png
popover.png

# Working folder of a test that must not be under /tmp (removed after the test)
tests/r8-work-*/
# Minecraft's icons are Mojang's: they live in ~/.claude/task-eta/minerali, never here
widget/miniera/**/*.png
widget/miniera/**/*.webp
